# Copia este archivo a .env y ajusta los valores.

# SQLite local (por defecto)
DATABASE_URL=sqlite:///./app.db
# Supabase (Postgres): Project Settings -> Database -> Connection string (Session pooler)
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Mínimo 32 caracteres. Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

TOTP_ISSUER=PatronesLab

# Llave AES-256-GCM (32 bytes, base64) para cifrar las semillas TOTP en la base.
# Genera una con: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOTP_ENCRYPTION_KEY=

# Servidor local de Prefect (prefect server start)
PREFECT_API_URL=http://127.0.0.1:4200/api
